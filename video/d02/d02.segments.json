[
 {
  "start": 0.0,
  "end": 2.54,
  "text": "大家好，歡迎回來，這裡是 iPAS"
 },
 {
  "start": 2.54,
  "end": 7.62,
  "text": "AIoT 應用工程師初級的有聲課，今天是第二天。"
 },
 {
  "start": 7.62,
  "end": 11.64,
  "text": "今天要把物聯網的骨架和「怎麼傳資料」講清楚"
 },
 {
  "start": 11.64,
  "end": 13.84,
  "text": "三層架構、感測模組"
 },
 {
  "start": 13.84,
  "end": 19.56,
  "text": "OSI 七層、RFID 和 NFC，還有各種無線通訊怎麼選。"
 },
 {
  "start": 19.56,
  "end": 23.52,
  "text": "名詞很多，我們一樣用生活例子把它們變成畫面。"
 },
 {
  "start": 23.52,
  "end": 24.68,
  "text": "好，出發！"
 },
 {
  "start": 24.68,
  "end": 28.82,
  "text": "第一段，對應考科一 2.1，物聯網三層架構。"
 },
 {
  "start": 28.82,
  "end": 33.98,
  "text": "物聯網三大特徵：全面感知、可靠傳遞、智慧處理。"
 },
 {
  "start": 33.98,
  "end": 37.1,
  "text": "架構分三層，用手搖飲外送來想。"
 },
 {
  "start": 37.1,
  "end": 41.38,
  "text": "感知層，是店員的眼睛和手，負責數據採集"
 },
 {
  "start": 41.38,
  "end": 43.76,
  "text": "把類比轉數位、用 RFID"
 },
 {
  "start": 43.76,
  "end": 46.5,
  "text": "NFC、QR Code 做識別"
 },
 {
  "start": 46.5,
  "end": 49.8,
  "text": "也能先做簡單邊緣運算，像先濾掉雜訊。"
 },
 {
  "start": 49.8,
  "end": 53.02,
  "text": "網路層，是外送員，要把資料「無縫"
 },
 {
  "start": 53.02,
  "end": 57.38,
  "text": "透明」送到應用層，裡面有存取網路和核心網路"
 },
 {
  "start": 57.38,
  "end": 59.187,
  "text": "還要做異質網路融合"
 },
 {
  "start": 59.187,
  "end": 62.56,
  "text": "像閘道器把 Zigbee 轉成 TCP／IP。"
 },
 {
  "start": 62.56,
  "end": 66.92,
  "text": "應用層，是老闆看報表做決策，靠雲端、大數據"
 },
 {
  "start": 66.92,
  "end": 70.74,
  "text": "AI，做設備管理、數據儲存、提供 API。"
 },
 {
  "start": 70.74,
  "end": 75.58,
  "text": "IoT 的傳輸特性通常是「小封包、高頻率」或「事件驅動」"
 },
 {
  "start": 75.58,
  "end": 79.38,
  "text": "所以網路層特別要注意封包遺失率和延遲。"
 },
 {
  "start": 79.38,
  "end": 83.8,
  "text": "還有，感知層元件不是各自獨立運作，例如按門鈴之後"
 },
 {
  "start": 83.8,
  "end": 88.36,
  "text": "通知攝影機開始人臉辨識，元件之間要交換資料。"
 },
 {
  "start": 88.36,
  "end": 92.96,
  "text": "口訣：感知、網路、應用，「看、送、想」。"
 },
 {
  "start": 92.96,
  "end": 96.78,
  "text": "第二段，考科一 2.1，常見感測模組。"
 },
 {
  "start": 96.78,
  "end": 99.98,
  "text": "HC-SR501，人體紅外線"
 },
 {
  "start": 99.98,
  "end": 105.76,
  "text": "被動接收人體紅外線變化，菲涅爾透鏡切出多個感應區，人來燈亮。"
 },
 {
  "start": 105.76,
  "end": 109.3,
  "text": "陷阱：它偵測不到靜止的人，也無法辨識身分。"
 },
 {
  "start": 109.3,
  "end": 113.56,
  "text": "想像你在廁所坐太久不動，燈就熄了，就是這個原因。"
 },
 {
  "start": 113.56,
  "end": 119.26,
  "text": "DHT11，溫濕度：電阻式濕度元件加 NTC 熱敏電阻"
 },
 {
  "start": 119.26,
  "end": 122.32,
  "text": "單線數位輸出，建議大約兩秒讀一次。"
 },
 {
  "start": 122.32,
  "end": 127.52,
  "text": "HC-SR04，超音波測距：發出 40 kHz超音波"
 },
 {
  "start": 127.52,
  "end": 133.46,
  "text": "量回波時間，距離等於聲速乘時間再除以二，因為聲音要去又回。"
 },
 {
  "start": 133.46,
  "end": 135.5,
  "text": "像在山谷喊一聲等回音。"
 },
 {
  "start": 135.5,
  "end": 141.4,
  "text": "不受光線、顏色影響，用在避障、液位、停車格、垃圾桶滿載。"
 },
 {
  "start": 141.4,
  "end": 144.58,
  "text": "考題常這樣問：超音波感測器量什麼？"
 },
 {
  "start": 144.58,
  "end": 147.06,
  "text": "量「距離」，不是量噪音分貝。"
 },
 {
  "start": 147.06,
  "end": 152.0,
  "text": "ADXL345，三軸加速度，MEMS 差動電容"
 },
 {
  "start": 152.0,
  "end": 156.84,
  "text": "走 I²C 或 SPI，用在計步、傾斜、跌倒偵測。"
 },
 {
  "start": 156.84,
  "end": 159.0,
  "text": "MPU6050，六軸"
 },
 {
  "start": 159.0,
  "end": 163.86,
  "text": "三軸加速度加三軸陀螺儀，陀螺儀靠科里奧利力量角速度"
 },
 {
  "start": 163.86,
  "end": 166.76,
  "text": "陀螺儀會漂移、加速度計怕震動"
 },
 {
  "start": 166.76,
  "end": 171.7,
  "text": "所以用互補或卡爾曼濾波一起算，平衡車、無人機都靠它。"
 },
 {
  "start": 171.7,
  "end": 176.4,
  "text": "MQ-2，可燃氣體與煙霧：加熱的二氧化錫半導體"
 },
 {
  "start": 176.4,
  "end": 179.22,
  "text": "遇到氣體電阻會下降，要預熱"
 },
 {
  "start": 179.22,
  "end": 182.6,
  "text": "選擇性差，炒菜油煙、酒精都可能干擾。"
 },
 {
  "start": 182.6,
  "end": 185.6,
  "text": "光敏電阻：光越強電阻越小"
 },
 {
  "start": 185.6,
  "end": 188.733,
  "text": "要串固定電阻做分壓再給 ADC 讀"
 },
 {
  "start": 188.733,
  "end": 191.48,
  "text": "像自動路燈；反應比光二極體慢。"
 },
 {
  "start": 191.48,
  "end": 196.82,
  "text": "另一個陷阱：室內燈光控制，用不到電子羅盤和加速度計。"
 },
 {
  "start": 196.82,
  "end": 202.26,
  "text": "第三段，考科一 2.1，OSI 七層與 TCP／IP 四層。"
 },
 {
  "start": 202.26,
  "end": 204.46,
  "text": "OSI 由 ISO 提出"
 },
 {
  "start": 204.46,
  "end": 208.66,
  "text": "分七層的目的，是解決異構網路互連的相容性問題。"
 },
 {
  "start": 208.66,
  "end": 213.98,
  "text": "口訣從上到下：「應、表、會、傳、網、鏈、實」。"
 },
 {
  "start": 213.98,
  "end": 218.46,
  "text": "用寄包裹來想：應用層是你要寄什麼，像 HTTP"
 },
 {
  "start": 218.46,
  "end": 222.36,
  "text": "FTP、SMTP；表達層負責格式轉換"
 },
 {
  "start": 222.36,
  "end": 226.22,
  "text": "壓縮解壓、加密解密，像把東西打包、上鎖"
 },
 {
  "start": 226.22,
  "end": 231.2,
  "text": "會議層建立和結束會談；傳輸層負責端對端可靠傳輸"
 },
 {
  "start": 231.2,
  "end": 235.64,
  "text": "代表是 TCP 和 UDP；網路層負責定址與路由"
 },
 {
  "start": 235.64,
  "end": 238.28,
  "text": "代表 IP、ICMP，像寫地址"
 },
 {
  "start": 238.28,
  "end": 242.813,
  "text": "決定走哪條路；資料鏈結層組成訊框、做錯誤偵測"
 },
 {
  "start": 242.813,
  "end": 247.96,
  "text": "像乙太網路；實體層傳送位元，就是電纜、光纖這些真正的路。"
 },
 {
  "start": 247.96,
  "end": 251.88,
  "text": "考題常這樣問：「加密、壓縮在哪一層？"
 },
 {
  "start": 251.88,
  "end": 253.42,
  "text": "」答案是表達層。"
 },
 {
  "start": 253.42,
  "end": 258.48,
  "text": "TCP／IP 不是砍掉層，而是把功能相近的層合併成四層"
 },
 {
  "start": 258.48,
  "end": 263.0,
  "text": "指引另外也用五層說明，看到四層或五層都別慌。"
 },
 {
  "start": 263.0,
  "end": 267.02,
  "text": "第四段，考科一 2.1，應用層場域速覽。"
 },
 {
  "start": 267.02,
  "end": 270.84,
  "text": "智慧家庭：「回家模式」一鍵開燈開冷氣。"
 },
 {
  "start": 270.84,
  "end": 274.86,
  "text": "智慧交通：AI 影像加地磁感測器算車流"
 },
 {
  "start": 274.86,
  "end": 277.52,
  "text": "動態調號誌，還有 V2X 車聯網。"
 },
 {
  "start": 277.52,
  "end": 282.46,
  "text": "智慧城市：智慧路燈變城市節點、智慧水務抓漏。"
 },
 {
  "start": 282.46,
  "end": 285.54,
  "text": "科技執法：區間測速、聲音照相。"
 },
 {
  "start": 285.54,
  "end": 290.38,
  "text": "智慧工廠：OT 和 IT 融合、預測性維護、數位孿生。"
 },
 {
  "start": 290.38,
  "end": 293.78,
  "text": "數位孿生，就像先在電玩裡把產線蓋一次"
 },
 {
  "start": 293.78,
  "end": 296.88,
  "text": "模擬驗證沒問題，再套用到真的產線。"
 },
 {
  "start": 296.88,
  "end": 300.1,
  "text": "智慧農業：從看天吃飯到精密農業"
 },
 {
  "start": 300.1,
  "end": 302.76,
  "text": "用 LoRaWAN、NB-IoT 回傳。"
 },
 {
  "start": 302.76,
  "end": 305.92,
  "text": "智慧醫療：連續血糖監測、遠距照護。"
 },
 {
  "start": 305.92,
  "end": 310.36,
  "text": "考題陷阱：「自動駕駛汽車」不是智慧醫療的例子。"
 },
 {
  "start": 310.36,
  "end": 315.0,
  "text": "第五段，考科一 2.2，RFID 頻段表，必背。"
 },
 {
  "start": 315.0,
  "end": 318.02,
  "text": "RFID 是用無線電波做非接觸式"
 },
 {
  "start": 318.02,
  "end": 323.16,
  "text": "雙向的自動識別，三元件：標籤、讀寫器、後端系統。"
 },
 {
  "start": 323.16,
  "end": 327.86,
  "text": "最常見是被動式，沒有電池，靠讀寫器電波感應供電。"
 },
 {
  "start": 327.86,
  "end": 332.16,
  "text": "四個頻段：低頻 125 到 134 千赫茲"
 },
 {
  "start": 332.16,
  "end": 334.5,
  "text": "距離小於 10 公分，穿透強"
 },
 {
  "start": 334.5,
  "end": 337.58,
  "text": "不怕金屬和水，用在動物晶片、門禁卡。"
 },
 {
  "start": 337.58,
  "end": 341.18,
  "text": "高頻 13.56 百萬赫茲，小於 1 公尺"
 },
 {
  "start": 341.18,
  "end": 343.96,
  "text": "用在圖書館、電子護照、智慧卡。"
 },
 {
  "start": 343.96,
  "end": 347.32,
  "text": "超高頻 860 到 960 百萬赫茲"
 },
 {
  "start": 347.32,
  "end": 348.94,
  "text": "3 到 10 公尺以上"
 },
 {
  "start": 348.94,
  "end": 354.24,
  "text": "防碰撞可以一次讀數百個，用在物流倉儲、ETC、零售盤點。"
 },
 {
  "start": 354.24,
  "end": 357.34,
  "text": "想像大賣場整台推車推過門口"
 },
 {
  "start": 357.34,
  "end": 361.5,
  "text": "幾百件商品一次結帳，這就是超高頻的威力。"
 },
 {
  "start": 361.5,
  "end": 364.56,
  "text": "微波 2.45 和 5.8 吉赫茲"
 },
 {
  "start": 364.56,
  "end": 368.68,
  "text": "大於 10 公尺，指向性強，用在行李追蹤。"
 },
 {
  "start": 368.68,
  "end": 373.1,
  "text": "口訣：「低頻動物門禁、高頻圖書護照"
 },
 {
  "start": 373.1,
  "end": 376.18,
  "text": "超高頻倉儲 ETC、微波追行李」。"
 },
 {
  "start": 376.18,
  "end": 380.68,
  "text": "第六段，考科一 2.2，NFC 與 RFID。"
 },
 {
  "start": 380.68,
  "end": 384.6,
  "text": "NFC 從 RFID 的高頻技術演變而來"
 },
 {
  "start": 384.6,
  "end": 387.4,
  "text": "固定 13.56 百萬赫茲"
 },
 {
  "start": 387.4,
  "end": 391.56,
  "text": "實務 4 公分以內，距離短反而是安全優勢"
 },
 {
  "start": 391.56,
  "end": 393.56,
  "text": "資料格式是 NDEF。"
 },
 {
  "start": 393.56,
  "end": 398.12,
  "text": "三種模式：卡片模擬，手機變悠遊卡、Apple Pay"
 },
 {
  "start": 398.12,
  "end": 403.94,
  "text": "通常需要安全元件 SE；讀卡機模式，手機去讀智慧海報"
 },
 {
  "start": 403.94,
  "end": 406.06,
  "text": "防偽標籤；點對點"
 },
 {
  "start": 406.06,
  "end": 409.32,
  "text": "物聯網最關鍵的是快速配對 Handover"
 },
 {
  "start": 409.32,
  "end": 413.96,
  "text": "碰一下藍牙喇叭，傳完連線資訊就切到藍牙或 Wi-Fi。"
 },
 {
  "start": 413.96,
  "end": 417.86,
  "text": "比較哲學：RFID 讓「物」被系統看見"
 },
 {
  "start": 417.86,
  "end": 422.7,
  "text": "一次讀很多；NFC 讓「人」與「物」互動，通常一對一。"
 },
 {
  "start": 422.7,
  "end": 425.9,
  "text": "第七段，考科一 2.2，Wi-Fi。"
 },
 {
  "start": 425.9,
  "end": 428.78,
  "text": "Wi-Fi 4 是 802.11n"
 },
 {
  "start": 428.78,
  "end": 433.02,
  "text": "目前最主流的 IoT 標準，ESP32 多採用。"
 },
 {
  "start": 433.02,
  "end": 436.52,
  "text": "Wi-Fi 5 是 ac，高頻寬但穿牆弱。"
 },
 {
  "start": 436.52,
  "end": 438.64,
  "text": "Wi-Fi 6 是 ax"
 },
 {
  "start": 438.64,
  "end": 442.58,
  "text": "關鍵字 TWT 目標喚醒時間加 OFDMA"
 },
 {
  "start": 442.58,
  "end": 448.38,
  "text": "省電又解決多裝置擁塞，像公車排班表，大家不用一直在站牌等。"
 },
 {
  "start": 448.38,
  "end": 452.02,
  "text": "Wi-Fi 7 是 be，MLO 多重連結。"
 },
 {
  "start": 452.02,
  "end": 454.32,
  "text": "Wi-Fi HaLow 是 ah"
 },
 {
  "start": 454.32,
  "end": 457.2,
  "text": "Sub-1G 大約 900 百萬赫茲"
 },
 {
  "start": 457.2,
  "end": 461.18,
  "text": "穿透強、約一公里、極低功耗，IoT 專用。"
 },
 {
  "start": 461.18,
  "end": 465.34,
  "text": "優勢是原生 IP，不用閘道器轉換就能上雲。"
 },
 {
  "start": 465.34,
  "end": 467.72,
  "text": "2.4 G 穿牆好但和藍牙"
 },
 {
  "start": 467.72,
  "end": 471.86,
  "text": "微波爐搶頻道；5G、6G 快但穿牆差。"
 },
 {
  "start": 471.86,
  "end": 475.48,
  "text": "限制是耗電，不適合鈕扣電池跑好幾年。"
 },
 {
  "start": 475.48,
  "end": 477.8,
  "text": "SSID 就是基地台識別碼。"
 },
 {
  "start": 477.8,
  "end": 481.02,
  "text": "第八段，考科一 2.2，藍牙。"
 },
 {
  "start": 481.02,
  "end": 485.24,
  "text": "經典藍牙適合持續大量傳輸，像耳機聽音樂"
 },
 {
  "start": 485.24,
  "end": 488.0,
  "text": "BLE 低功耗藍牙平常睡覺"
 },
 {
  "start": 488.0,
  "end": 490.67,
  "text": "需要時毫秒級醒來傳一下"
 },
 {
  "start": 490.67,
  "end": 494.86,
  "text": "鈕扣電池能撐好幾年，像手環、心率帶、門鎖。"
 },
 {
  "start": 494.86,
  "end": 496.98,
  "text": "GAP 管廣播和連線"
 },
 {
  "start": 496.98,
  "end": 501.28,
  "text": "手環是周邊在廣播，手機是中央去掃描連線。"
 },
 {
  "start": 501.28,
  "end": 503.56,
  "text": "GATT 管連線後的資料"
 },
 {
  "start": 503.56,
  "end": 508.34,
  "text": "階層是服務再到特徵，例如心率服務裡的心率數值。"
 },
 {
  "start": 508.34,
  "end": 511.36,
  "text": "藍牙 5.0 兩倍速加 Long Range"
 },
 {
  "start": 511.36,
  "end": 513.02,
  "text": "5.1 有 AoA"
 },
 {
  "start": 513.02,
  "end": 516.54,
  "text": "AoD 測角定位，室內定位到公分級"
 },
 {
  "start": 516.54,
  "end": 518.44,
  "text": "Mesh 可以讓燈泡接力。"
 },
 {
  "start": 518.44,
  "end": 520.56,
  "text": "Beacon 用廣播推優惠券"
 },
 {
  "start": 520.56,
  "end": 523.72,
  "text": "你走進百貨公司手機就跳出折價券"
 },
 {
  "start": 523.72,
  "end": 526.84,
  "text": "無鑰匙解鎖用 RSSI 判斷距離。"
 },
 {
  "start": 526.84,
  "end": 529.96,
  "text": "第九段，考科一 2.2，Zigbee。"
 },
 {
  "start": 529.96,
  "end": 532.36,
  "text": "Zigbee 是 802.15.4"
 },
 {
  "start": 532.36,
  "end": 535.32,
  "text": "低速率、低功耗、大量節點組網。"
 },
 {
  "start": 535.32,
  "end": 540.26,
  "text": "三個角色，用一家公司來比：協調器是老闆，選頻道"
 },
 {
  "start": 540.26,
  "end": 545.12,
  "text": "設 PAN ID、發位址，一個網路只能有一個；路由器是主管"
 },
 {
  "start": 545.12,
  "end": 549.78,
  "text": "負責轉發，通常是插電的燈泡、插座；終端裝置是員工"
 },
 {
  "start": 549.78,
  "end": 554.2,
  "text": "只處理自己的事、不轉發，大多在睡，像門窗感測器。"
 },
 {
  "start": 554.2,
  "end": 558.92,
  "text": "網狀多跳，路由器壞了會自動找別條路，叫自我修復。"
 },
 {
  "start": 558.92,
  "end": 561.74,
  "text": "限制：最高 250 kbps"
 },
 {
  "start": 561.74,
  "end": 565.3,
  "text": "手機沒有 Zigbee 晶片，一定要透過網關。"
 },
 {
  "start": 565.3,
  "end": 567.66,
  "text": "Zigbee 聯盟已改名 CSA"
 },
 {
  "start": 567.66,
  "end": 570.44,
  "text": "推動 Matter；Matter 不支援 LoRa。"
 },
 {
  "start": 570.44,
  "end": 575.0,
  "text": "第十段，考科一 2.2，NB-IoT 與 LoRaWAN。"
 },
 {
  "start": 575.0,
  "end": 579.74,
  "text": "NB-IoT 用授權頻譜，架在電信基地台上，覆蓋超好"
 },
 {
  "start": 579.74,
  "end": 584.72,
  "text": "地下室、下水道都收得到，適合智慧水表、路燈、人孔蓋。"
 },
 {
  "start": 584.72,
  "end": 586.81,
  "text": "LoRaWAN 用非授權頻譜"
 },
 {
  "start": 586.81,
  "end": 590.68,
  "text": "台灣 920 到 925 百萬赫茲，可以自建基地台"
 },
 {
  "start": 590.68,
  "end": 593.98,
  "text": "不用月租，空曠地可達 10 公里以上"
 },
 {
  "start": 593.98,
  "end": 597.18,
  "text": "適合大農場土壤監測、土石流預警。"
 },
 {
  "start": 597.18,
  "end": 600.2,
  "text": "比喻：NB-IoT 像辦手機門號"
 },
 {
  "start": 600.2,
  "end": 602.8,
  "text": "LoRa 像自己在農場架對講機。"
 },
 {
  "start": 602.8,
  "end": 607.12,
  "text": "注意這個標註：指引寫 NB-IoT「不支援移動性」"
 },
 {
  "start": 607.12,
  "end": 610.76,
  "text": "這是早期版本的特性，後續版本已逐步改善"
 },
 {
  "start": 610.76,
  "end": 613.04,
  "text": "但考試以指引說法作答。"
 },
 {
  "start": 613.04,
  "end": 617.28,
  "text": "第十一段，考科一 2.2，4G、5G 與 SIM。"
 },
 {
  "start": 617.28,
  "end": 620.46,
  "text": "LTE Cat.1 大約 10 Mbps"
 },
 {
  "start": 620.46,
  "end": 624.96,
  "text": "成本功耗低，公車動態、共享單車、電梯聯網最愛用。"
 },
 {
  "start": 624.96,
  "end": 629.6,
  "text": "5G 三大場景，口訣「eMBB 快、mMTC 多"
 },
 {
  "start": 629.6,
  "end": 634.04,
  "text": "URLLC 準」：eMBB 網速可達 10 Gbps"
 },
 {
  "start": 634.04,
  "end": 636.24,
  "text": "看 8K 串流、AR、VR"
 },
 {
  "start": 636.24,
  "end": 639.52,
  "text": "mMTC 每平方公里一百萬個裝置"
 },
 {
  "start": 639.52,
  "end": 644.1,
  "text": "URLLC 延遲小於 1 毫秒，車聯網、遠端手術。"
 },
 {
  "start": 644.1,
  "end": 648.48,
  "text": "SIM 有工業級、eSIM 可 OTA 遠端換電信商"
 },
 {
  "start": 648.48,
  "end": 650.32,
  "text": "iSIM 整合進晶片。"
 },
 {
  "start": 650.32,
  "end": 655.84,
  "text": "考題陷阱：5G 不是低功耗長距離技術，那是 LPWAN。"
 },
 {
  "start": 655.84,
  "end": 659.54,
  "text": "第十二段，考科一 2.2，選型總表。"
 },
 {
  "start": 659.54,
  "end": 664.08,
  "text": "小情境題：想像你是工程師，要幫一個城市選通訊。"
 },
 {
  "start": 664.08,
  "end": 666.84,
  "text": "路邊水表、電池供電、資料極少？"
 },
 {
  "start": 666.84,
  "end": 669.12,
  "text": "NB-IoT 或 LoRaWAN。"
 },
 {
  "start": 669.12,
  "end": 671.98,
  "text": "共享機車要定位、會移動、資料中等？"
 },
 {
  "start": 671.98,
  "end": 673.7,
  "text": "LTE Cat.1。"
 },
 {
  "start": 673.7,
  "end": 675.58,
  "text": "路口監視器要即時影像？"
 },
 {
  "start": 675.58,
  "end": 678.5,
  "text": "4G Cat.4 或 5G eMBB。"
 },
 {
  "start": 678.5,
  "end": 680.98,
  "text": "自駕車、遠端醫療不能延遲？"
 },
 {
  "start": 680.98,
  "end": 682.86,
  "text": "5G URLLC。"
 },
 {
  "start": 682.86,
  "end": 684.6,
  "text": "家裡看影片、AR？"
 },
 {
  "start": 684.6,
  "end": 685.6,
  "text": "Wi-Fi。"
 },
 {
  "start": 685.6,
  "end": 686.44,
  "text": "手環？"
 },
 {
  "start": 686.44,
  "end": 687.927,
  "text": "BLE。"
 },
 {
  "start": 687.927,
  "end": 690.4,
  "text": "整棟樓幾百個低速感測器？"
 },
 {
  "start": 690.4,
  "end": 691.94,
  "text": "Zigbee。"
 },
 {
  "start": 691.94,
  "end": 692.76,
  "text": "碰一下支付？"
 },
 {
  "start": 692.76,
  "end": 694.2,
  "text": "NFC。"
 },
 {
  "start": 694.2,
  "end": 696.18,
  "text": "好，口頭自測時間！"
 },
 {
  "start": 696.18,
  "end": 698.72,
  "text": "每題念完，你先在心裡作答。"
 },
 {
  "start": 698.72,
  "end": 703.86,
  "text": "第一題：OSI 哪一層負責加密和壓縮？"
 },
 {
  "start": 703.86,
  "end": 704.91,
  "text": "先想一想……"
 },
 {
  "start": 709.4,
  "end": 712.04,
  "text": "好，答案是表達層。"
 },
 {
  "start": 712.04,
  "end": 717.84,
  "text": "第二題：倉庫要一次讀取幾百件貨物，選哪個 RFID 頻段？"
 },
 {
  "start": 717.84,
  "end": 718.97,
  "text": "先想一想……"
 },
 {
  "start": 723.54,
  "end": 727.1,
  "text": "好，答案是超高頻 UHF。"
 },
 {
  "start": 727.1,
  "end": 731.36,
  "text": "第三題：Zigbee 網路裡，協調器可以有幾個？"
 },
 {
  "start": 731.36,
  "end": 732.55,
  "text": "先想一想……"
 },
 {
  "start": 737.15,
  "end": 739.43,
  "text": "好，答案是只能有一個。"
 },
 {
  "start": 739.43,
  "end": 745.57,
  "text": "第四題：可以自建基地台、不用月租的 LPWAN 是哪個？"
 },
 {
  "start": 745.57,
  "end": 746.68,
  "text": "先想一想……"
 },
 {
  "start": 751.28,
  "end": 753.82,
  "text": "好，答案是 LoRaWAN。"
 },
 {
  "start": 753.82,
  "end": 758.36,
  "text": "第五題：5G 裡延遲小於 1 毫秒的是哪個場景？"
 },
 {
  "start": 758.36,
  "end": 759.47,
  "text": "先想一想……"
 },
 {
  "start": 764.11,
  "end": 767.19,
  "text": "好，答案是 URLLC。"
 },
 {
  "start": 767.19,
  "end": 768.47,
  "text": "最後回顧。"
 },
 {
  "start": 768.47,
  "end": 771.85,
  "text": "三層架構：看、送、想。"
 },
 {
  "start": 771.85,
  "end": 776.51,
  "text": "OSI：應表會傳網鏈實，表達層管加密壓縮。"
 },
 {
  "start": 776.51,
  "end": 782.11,
  "text": "超高頻一次讀數百，NFC 13.56、4 公分內。"
 },
 {
  "start": 782.11,
  "end": 785.81,
  "text": "Wi-Fi 6 是 TWT 加 OFDMA"
 },
 {
  "start": 785.81,
  "end": 787.95,
  "text": "HaLow 是 Sub-1G。"
 },
 {
  "start": 787.95,
  "end": 793.33,
  "text": "BLE：GAP 廣播連線、GATT 服務特徵。"
 },
 {
  "start": 793.33,
  "end": 796.93,
  "text": "Zigbee 協調器只有一個、終端不轉發。"
 },
 {
  "start": 796.93,
  "end": 800.73,
  "text": "NB-IoT 授權頻譜，LoRa 可自建。"
 },
 {
  "start": 800.73,
  "end": 803.55,
  "text": "5G：快、多、準。"
 },
 {
  "start": 803.55,
  "end": 807.34,
  "text": "第二天就到這裡，辛苦了，我們明天見！"
 }
]