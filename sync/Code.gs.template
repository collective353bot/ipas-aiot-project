/**
 * iPAS AIoT 讀書 App — 雲端進度同步後端（Google Apps Script Web App）
 * 每個同步 id 存一列於工作表「sync」：A=id, B=updatedAt(ms), C..=JSON 分段（每格 ≤ 45000 字元）
 * Request: POST, body = text/plain JSON {k, id, op:'get'|'put', data?}
 * Response: JSON {ok, data, updatedAt} 或 {ok:false, error}
 */
const SECRET = '__SECRET__';
const SHEET = 'sync';
const CHUNK = 45000;
const MAX_CHUNKS = 40; // ~1.8 MB 上限

function out_(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}
function sheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet() ||
    SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SHEET_ID') || setupSheet_());
  return ss.getSheetByName(SHEET) || ss.insertSheet(SHEET);
}
// 獨立腳本（非綁定試算表）時自動建立試算表並記住 ID
function setupSheet_() {
  const ss = SpreadsheetApp.create('ipas_aiot_sync');
  PropertiesService.getScriptProperties().setProperty('SHEET_ID', ss.getId());
  return ss.getId();
}
function findRow_(sh, id) {
  const n = sh.getLastRow();
  if (n < 1) return 0;
  const ids = sh.getRange(1, 1, n, 1).getValues();
  for (let i = 0; i < n; i++) if (String(ids[i][0]) === id) return i + 1;
  return 0;
}
function eq_(a, b) { // 固定時間比較
  if (typeof a !== 'string' || a.length !== b.length) return false;
  let r = 0; for (let i = 0; i < a.length; i++) r |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return r === 0;
}
function handle_(req) {
  if (!req || !eq_(req.k, SECRET)) return { ok: false, error: 'unauthorized' };
  const id = String(req.id || 'default').slice(0, 64);
  const sh = sheet_();
  if (req.op === 'get') {
    const r = findRow_(sh, id);
    if (!r) return { ok: true, data: null, updatedAt: 0 };
    const w = sh.getLastColumn();
    const row = sh.getRange(r, 1, 1, Math.max(w, 2)).getValues()[0];
    return { ok: true, data: row.slice(2).map(String).join('') || null, updatedAt: Number(row[1]) || 0 };
  }
  if (req.op === 'put') {
    if (typeof req.data !== 'string') return { ok: false, error: 'data must be string' };
    const parts = [];
    for (let i = 0; i < req.data.length; i += CHUNK) parts.push(req.data.slice(i, i + CHUNK));
    if (parts.length > MAX_CHUNKS) return { ok: false, error: 'too large' };
    const lock = LockService.getScriptLock();
    lock.waitLock(20000);
    try {
      let r = findRow_(sh, id);
      if (!r) { r = sh.getLastRow() + 1; }
      const now = Date.now();
      const w = Math.max(sh.getLastColumn(), parts.length + 2);
      const vals = [id, now].concat(parts);
      while (vals.length < w) vals.push('');
      sh.getRange(r, 1, 1, w).setNumberFormat('@').setValues([vals.map(String)]);
      return { ok: true, updatedAt: now };
    } finally { lock.releaseLock(); }
  }
  return { ok: false, error: 'bad op' };
}
function doPost(e) {
  try { return out_(handle_(JSON.parse((e && e.postData && e.postData.contents) || '{}'))); }
  catch (err) { return out_({ ok: false, error: String(err) }); }
}
// GET 僅用於測試部署是否成功：…/exec?k=SECRET&op=get
function doGet(e) {
  try { const p = (e && e.parameter) || {}; return out_(handle_({ k: p.k, id: p.id, op: 'get' })); }
  catch (err) { return out_({ ok: false, error: String(err) }); }
}
